# ─────────────────────────────────────────────────────────────
#  Nearby Shop Website Presence Detection Platform – Backend
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://shopuser:shoppassword@localhost:5432/shopdb

# ── MongoDB Atlas Connection ─────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.d65tyux.mongodb.net/shop_presence?appName=Cluster0&compressors=zlib
MONGODB_DB_NAME=shop_presence

# ── JWT ──────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Outside ENVIRONMENT=development the app refuses to start with a weak/default value.
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Google Places API ─────────────────────────────────────────
# Get your key at: https://console.cloud.google.com/
# Enable: Places API (New), Maps JavaScript API, Geocoding API
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Set to "true" to use mock data instead of real Google Places API
USE_MOCK_PLACES=false

# ── Gemini AI (for chat suggestions) ─────────────────────────
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Set to "true" to use rule-based chat instead of Gemini AI
USE_RULE_BASED_CHAT=false

# ── App Settings ──────────────────────────────────────────────
APP_NAME=ShopPresence
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Website Analysis ──────────────────────────────────────────
WEBSITE_CHECK_TIMEOUT_SECONDS=10
MAX_REDIRECT_FOLLOW=5

# ── WhatsApp automation (Mr LAD gateway + Meta webhook) ──────────
# Gateway login (REQUIRED for sending; no defaults are built in any more)
LAD_AUTH_EMAIL=
LAD_AUTH_PASSWORD=
# Meta webhook: the handshake token and the App Secret used to verify X-Hub-Signature-256.
# Unsigned webhooks are rejected unless WHATSAPP_ALLOW_UNSIGNED_WEBHOOK=true (local dev only).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOW_UNSIGNED_WEBHOOK=false
# Safety limits
WHATSAPP_DAILY_SEND_LIMIT=200
WHATSAPP_MAX_BROADCAST_BATCH=50
WHATSAPP_BROADCAST_DELAY_SECONDS=1.5
WHATSAPP_REPEAT_COOLDOWN_DAYS=7
WHATSAPP_POLLER_ENABLED=true
WHATSAPP_POLL_INTERVAL_SECONDS=30
WHATSAPP_REPLY_MAX_AGE_MINUTES=15
# Optional: mirror outbound pitches to this admin number, e.g. +917780181920 (empty = off)
WHATSAPP_ADMIN_COPY_NUMBER=

# ── Accounts / auth ──────────────────────────────────────────
# Admin self-registration is disabled unless this is set. Use a long random value.
ADMIN_SECRET_CODE=
# Google Sign-In OAuth client id (ID tokens are verified server-side against it)
GOOGLE_CLIENT_ID=
# SMTP for password-reset codes (without it, codes cannot be delivered in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Brute-force protection
RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
